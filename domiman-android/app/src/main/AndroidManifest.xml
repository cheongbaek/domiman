<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- domiserver TCP(47821) 접속 — domichat 프로토콜 수/발신에 필요 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 백그라운드 알림 게시(Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 백그라운드에서 프로세스를 살려두는 포그라운드 서비스.
         dataSync는 Android 14+에서 하루 6시간 제한이 있어 장기 방치 시 종료된다
         → 시간 제한이 없는 specialUse를 주 타입으로 쓰고, 구버전 폴백으로 dataSync 병기. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 절전모드(배터리 최적화) 예외 요청 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".DomimanApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Domiman">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 홈 위젯 '스크린샷' 칸에서 여는 단독 화면. taskAffinity=""로 앱의 다른
             화면과 별개 태스크로 띄워, 뒤로 가기를 누르면 MainActivity를 거치지
             않고 곧바로 홈 화면으로 돌아간다(singleInstance로 항상 새 태스크). -->
        <activity
            android:name=".ScreenshotActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <!-- 스크린샷 클립보드 복사용 FileProvider — 캐시에 쓴 PNG를 content:// URI로
             내줘 ClipData.newUri가 다른 앱에도 읽기 권한을 넘길 수 있게 한다. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 백그라운드 domichat 수신·알림 유지용 포그라운드 서비스.
             specialUse|dataSync: 34+는 시간제한 없는 specialUse, 그 미만은 dataSync. -->
        <service
            android:name=".DomimanService"
            android:exported="false"
            android:foregroundServiceType="specialUse|dataSync">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="domichat_remote_control" />
        </service>

        <!-- 홈 위젯(4x1). 커스텀 액션 PendingIntent는 명시적(자기 UID)이라
             exported=false로 충분. 시스템의 APPWIDGET_UPDATE는 프레임워크가 전달. -->
        <receiver
            android:name=".DomimanWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/domiman_widget_info" />
        </receiver>
    </application>

</manifest>
